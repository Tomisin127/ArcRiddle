{
  "buildCommand": "bunx vite build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/riddle.ts": {
      "runtime": "@vercel/node"
    }
  },
  "routes": [
    { "src": "/api/riddle", "dest": "/api/riddle.ts" },
    { "src": "/api/health", "dest": "/api/riddle.ts" },
    { "handle": "filesystem" },
    { "src": "/(.*)",       "dest": "/index.html" }
  ]
}
